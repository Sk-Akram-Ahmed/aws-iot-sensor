# AWS IoT Core Configuration
AWS_IOT_ENDPOINT=your-iot-endpoint.iot.us-east-1.amazonaws.com
AWS_IOT_PORT=8883
MQTT_TOPIC=iot/sensor/data

# Certificate file paths (relative to project root)
CA_CERT_FILE=AmazonRootCA1.pem
CLIENT_CERT_FILE=your-certificate.pem.crt
CLIENT_KEY_FILE=your-private.pem.key

# S3 Configuration
S3_BUCKET_NAME=your-bucket-name

# DynamoDB Configuration
DYNAMODB_TABLE_NAME=your-table-name
